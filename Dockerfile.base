ARG FROM_IMAGE_NAME=gitlab-master.nvidia.com:5005/dl/dgx/pytorch:main-py3-devel
ARG FROM_SCRIPTS_IMAGE=gitlab-master.nvidia.com:5005/dl/devops/build-scripts:main
ARG FRAMEWORK=pytorch
ARG CCACHE_IMAGE=scratch

FROM ${CCACHE_IMAGE} AS ccache-state
FROM ${FROM_SCRIPTS_IMAGE} AS build-scripts
FROM scratch as transformerengine
COPY 3rdparty/ 3rdparty/
COPY docs/ docs/
COPY examples/ examples/
COPY qa/ qa/
COPY tests/ tests/
COPY transformer_engine/ transformer_engine/
COPY build_tools/ build_tools/
COPY CONTRIBUTING.rst LICENSE README.rst setup.py pylintrc CPPLINT.cfg .

FROM ${FROM_IMAGE_NAME}
ARG FRAMEWORK

WORKDIR /opt/transformerengine/
COPY --from=transformerengine . .

# Disable Pip constraint file
### TODO (tmoon): Update constraint file with TE dependency versions
ENV PIP_CONSTRAINT=

# Install dependencies
# Note: PIP_BREAK_SYSTEM_PACKAGES is required because otherwise Ubuntu
# 23+ only allows pip install within venv.
ENV PIP_BREAK_SYSTEM_PACKAGES=1
RUN <<"EOF" bash -e
  [[ "${FRAMEWORK}" == "core" ]] \
  && apt-get update \
  && apt-get install -y git python3 python3-pip \
  && pip3 install cmake==3.21.0 nvidia-cudnn-cu12==9.9.0.52 \
  || [[ ! "${FRAMEWORK}" == "core" ]]

  pip3 install ninja pybind11

  [[ "${FRAMEWORK}" =~ pytorch|all ]] \
  && pip3 install nvidia-cutlass-dsl[cu13]==4.4.1 nvidia-cudnn-frontend[cutedsl]==1.21.0 \
  || [[ ! "${FRAMEWORK}" =~ pytorch|all ]]
EOF

# Install google logging lib for paddle ci as a hotfix.
# TODO (ksivamai): fix in TE build
RUN apt-get update && apt-get install -y libgoogle-glog-dev ccache

RUN --mount=from=ccache-state,target=/ccache-state <<"EOF" bash -e
  mkdir -p /ccache
  if [ -d /ccache-state/ccache ]; then
    cp -a /ccache-state/ccache/. /ccache/
    echo "Restored ccache state from cache image"
  else
    echo "No ccache state found, starting with empty cache"
  fi
EOF

RUN --mount=from=build-scripts,source=build-scripts,target=/nvidia/build-scripts <<"EOF" bash -e
  export CUBLASMP_VERSION=0.8.0.2023
  /nvidia/build-scripts/installCUBLASMP.sh
EOF

RUN --mount=from=build-scripts,source=build-scripts,target=/nvidia/build-scripts <<"EOF" bash -e
  [[ "${FRAMEWORK}" == "jax" ]] \
  && apt-get update \
  && apt-get install -y python3 python3-pip \
  && pip3 install cmake==3.21.0 \
  || [[ ! "${FRAMEWORK}" == "jax" ]]
EOF

# Optionally install a different cuDNN backend version.
# Set CUDNN_BACKEND_URL to a tarball URL to override the version in the base image.
# Leave empty/unset to use the cuDNN already present in the container.
ARG CUDNN_BACKEND_URL=""

# Log the cuDNN version present in the base image
RUN <<"EOF" bash -e
  LOG=/var/log/cudnn_install.log
  HEADER=$(find /usr/include /usr/local/include -name "cudnn_version.h" 2>/dev/null | head -1)
  if [[ -n "${HEADER}" ]]; then
    MAJOR=$(grep "#define CUDNN_MAJOR" "${HEADER}" | awk '{print $3}')
    MINOR=$(grep "#define CUDNN_MINOR" "${HEADER}" | awk '{print $3}')
    PATCH=$(grep "#define CUDNN_PATCHLEVEL" "${HEADER}" | awk '{print $3}')
    BASE_VER="${MAJOR}.${MINOR}.${PATCH}"
    DPKG_VER=$(dpkg-query -W -f='${Version}\n' 'libcudnn9-cuda-*' 2>/dev/null | head -1)
    [[ -n "${DPKG_VER}" ]] && BASE_VER="${DPKG_VER}"
  else
    BASE_VER="unknown"
  fi
  echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] base-image cuDNN: ${BASE_VER}" >> "${LOG}"
EOF

RUN <<"EOF" bash -e
  if [[ -z "${CUDNN_BACKEND_URL}" ]]; then
    echo "CUDNN_BACKEND_URL not set; using cuDNN from base image"
    exit 0
  fi

  LOG=/var/log/cudnn_install.log
  echo "FRAMEWORK is ${FRAMEWORK}"
  echo "cuDNN override URL: ${CUDNN_BACKEND_URL}"

  cd /opt
  wget "${CUDNN_BACKEND_URL}"
  TAR_FILE=$(basename "${CUDNN_BACKEND_URL}")
  tar xvf "${TAR_FILE}"
  rm -f "${TAR_FILE}"
  echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] installed cuDNN from ${CUDNN_BACKEND_URL} (framework: ${FRAMEWORK})" >> "${LOG}"
  echo "Installed cuDNN override for ${FRAMEWORK} from ${CUDNN_BACKEND_URL}"

  # Make the override visible to the linker
  echo "/opt/cudnn/lib" > /etc/ld.so.conf.d/cudnn-override.conf
  ldconfig

  # For core containers, persist cuDNN env vars (pytorch/jax base images set these already)
  if [[ "${FRAMEWORK}" == "core" ]]; then
    {
      echo 'export LD_LIBRARY_PATH="/opt/cudnn/lib:${LD_LIBRARY_PATH}"'
      echo 'export CUDNN_PATH="/opt/cudnn"'
      echo 'export CUDNN_HOME="/opt/cudnn"'
    } > /etc/profile.d/cudnn-override.sh
  fi
EOF

# Install Transformer Engine
RUN <<"EOF" bash -e
  export CCACHE_DIR=/ccache
  export CCACHE_MAXSIZE=10G
  export NVTE_USE_CCACHE=1

  # If a cuDNN override was installed to /opt/cudnn, make it visible
  if [[ -d /opt/cudnn ]]; then
    export LD_LIBRARY_PATH="/opt/cudnn/lib:${LD_LIBRARY_PATH}"
    export CUDNN_PATH="/opt/cudnn"
    export CUDNN_HOME="/opt/cudnn"
  fi

  [[ "${FRAMEWORK}" =~ pytorch|all ]] \
  && export NVTE_WITH_USERBUFFERS=1 \
  && export MPI_HOME=/usr/local/mpi \
  && export MAX_JOBS=4 \
  || [[ ! "${FRAMEWORK}" =~ pytorch|all ]]

  [[ "${FRAMEWORK}" == "core" ]] \
  && export NVTE_FRAMEWORK=none \
  || export NVTE_FRAMEWORK=${FRAMEWORK}

  [[ "${FRAMEWORK}" == "jax" ]] \
  && export NVTE_WITH_CUBLASMP=0 \
  || export NVTE_WITH_CUBLASMP=1

  NVTE_BUILD_THREADS_PER_JOB=4 \
  CUBLASMP_HOME=/usr \
  pip3 install --verbose --verbose --no-build-isolation .[test]

  ccache --show-stats

  rm -rf transformer_engine.egg-info dist build

  LOG=/var/log/cudnn_install.log
  FE_INFO=/opt/transformerengine/3rdparty/cudnn-frontend/.build_info
  if [[ -f "${FE_INFO}" ]]; then
    FE_COMMIT=$(grep '^commit=' "${FE_INFO}" | cut -d= -f2-)
    FE_REMOTE=$(grep '^remote=' "${FE_INFO}" | cut -d= -f2-)
    FE_SOURCE=$(grep '^source=' "${FE_INFO}" | cut -d= -f2-)
  else
    FE_COMMIT="unknown"
    FE_REMOTE="unknown"
    FE_SOURCE="no .build_info found"
  fi
  echo "[$(date -u '+%Y-%m-%dT%H:%M:%SZ')] cudnn-frontend: commit ${FE_COMMIT} remote ${FE_REMOTE} (${FE_SOURCE})" >> "${LOG}"
EOF

RUN <<"EOF" bash -e
  echo "=== cuDNN install history ==="
  cat /var/log/cudnn_install.log
  echo "============================="
EOF

WORKDIR /workspace/
